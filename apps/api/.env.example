NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:3000
# Run pnpm setup:local to generate real local credentials into ignored files.
DATABASE_URL=
REDIS_URL=
CSRF_SECRET=
# Keep empty for local Next rewrites. Production: exact trusted Caddy IPs only.
TRUSTED_PROXY_IPS=
# Development/test: local directory outside the webroot. Production requires s3.
FILE_STORAGE=local
# Empty uses the project's ignored .local/files (.local/files-test with NODE_ENV=test).
FILE_LOCAL_ROOT=
PDF_MAX_BYTES=26214400
# S3 uses AWS SDK credential chain; never place credentials in committed files.
S3_BUCKET=
AWS_REGION=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
PDFINFO_BIN=pdfinfo
PDFTOTEXT_BIN=pdftotext
# Worker only; Compose supplies an internal URL. No public converter port.
DOCX_CONVERTER_URL=
# Password recovery mail (AUTH-03). Empty turns recovery off: the form tells users to
# contact an administrator. `file` writes JSON messages to MAIL_DIR (absolute path; refused in
# production). `smtp` needs SMTP_URL (smtp:// or smtps://, credentials only in ignored files).
MAIL_TRANSPORT=
MAIL_DIR=
SMTP_URL=
MAIL_FROM=
