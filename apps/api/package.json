{
  "name": "@hucescholar/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:generate && node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "pnpm db:generate && nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "worker:files": "node --env-file-if-exists=.env dist/file-worker.js",
    "lint": "eslint src test",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "jest --runInBand",
    "prisma": "node --env-file-if-exists=.env node_modules/prisma/build/index.js",
    "db:migrate": "pnpm prisma migrate deploy",
    "db:generate": "pnpm prisma generate",
    "test:integration": "node --env-file-if-exists=../../.local/test.env node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
    "db:bootstrap-admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.bootstrap dist/scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.12",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14"
  }
}
