/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model document_versions {
  id                                                           BigInt                @id @default(autoincrement())
  document_id                                                  BigInt                @unique(map: "ux_one_working_version", where: raw("((review_status)::text = ANY ((ARRAY['DRAFT'::character varying, 'SUBMITTED'::character varying, 'CHANGES_REQUIRED'::character varying])::text[]))"))
  version_no                                                   Int
  file_id                                                      BigInt?
  source_upload_id                                              BigInt?
  source_upload                                                 document_source_uploads? @relation("CurrentSource", fields: [id, source_upload_id], references: [version_id, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_version_source_same_version")
  source_uploads                                                document_source_uploads[] @relation("SourceVersion")
  created_by                                                   BigInt
  title                                                        String                @db.VarChar(300)
  authors                                                      String                @default("")
  description                                                  String                @default("")
  material_type                                                String                @db.VarChar(20)
  publication_year                                             Int?                  @db.SmallInt
  source_reference                                             String
  rights_basis                                                 String
  rights_valid_until                                           DateTime?             @db.Timestamptz(6)
  download_allowed                                             Boolean               @default(false)
  review_status                                                String                @default("DRAFT") @db.VarChar(20)
  publication_method                                           String                @default("ADMIN_REVIEW") @db.VarChar(20)
  change_summary                                               String                @default("")
  search_text                                                  String                @default("")
  created_at                                                   DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                                   DateTime              @default(now()) @db.Timestamptz(6)
  revision                                                     Int                   @default(1)
  annotations                                                  annotations[]
  users                                                        users                 @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  documents_document_versions_document_idTodocuments           documents             @relation("document_versions_document_idTodocuments", fields: [document_id], references: [id], onUpdate: NoAction)
  files                                                        files?                @relation(fields: [file_id], references: [id], onUpdate: NoAction)
  /// Prisma cannot infer the composite FK uniqueness from documents.id; SQL remains authoritative.
  documents_documents_id_current_version_idTodocument_versions documents[]           @relation("documents_id_current_version_idTodocument_versions")
  publication_requests                                         publication_requests?
  reading_progress                                             reading_progress[]
  reports                                                      reports[]
  version_courses                                              version_courses[]

  @@unique([document_id, id])
  @@unique([document_id, version_no])
  @@index([file_id], map: "ix_version_file")
  @@schema("hucescholar")
}

