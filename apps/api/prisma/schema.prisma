generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["hucescholar"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model document_source_uploads {
  id BigInt @id @default(autoincrement())
  version_id BigInt
  uploaded_by BigInt
  request_id String @db.Uuid
  object_key String @unique @db.VarChar(500)
  original_name String @db.VarChar(255)
  mime_type String @default("application/vnd.openxmlformats-officedocument.wordprocessingml.document") @db.VarChar(80)
  byte_size BigInt
  sha256 String @db.Char(64)
  scan_status String @default("CHECKING") @db.VarChar(8)
  checked_at DateTime? @db.Timestamptz(6)
  conversion_status String @default("QUEUED") @db.VarChar(12)
  error_code String? @db.VarChar(40)
  rendered_file_id BigInt?
  converter_build String? @db.VarChar(200)
  processing_token String? @db.Uuid
  lease_expires_at DateTime? @db.Timestamptz(6)
  attempt_count Int @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  version document_versions @relation("SourceVersion", fields: [version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  current_versions document_versions[] @relation("CurrentSource")
  uploader users @relation(fields: [uploaded_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rendition files? @relation(fields: [rendered_file_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([uploaded_by, request_id], map: "ux_source_owner_request")
  @@unique([version_id, id], map: "ux_source_version_id")
  @@index([id], map: "ix_source_pending", where: raw("((conversion_status)::text = ANY (ARRAY['QUEUED'::text, 'RUNNING'::text]))"))
  @@schema("hucescholar")
}

model annotations {
  id                BigInt            @id @default(autoincrement())
  request_id        String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           BigInt
  version_id        BigInt
  page_number       Int
  kind              String            @db.VarChar(16)
  content           String            @default("")
  anchor            Json?
  color             String            @default("#FFF59D") @db.VarChar(7)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  revision          Int               @default(1)
  users             users             @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  document_versions document_versions @relation(fields: [version_id], references: [id], onUpdate: NoAction)

  @@index([user_id, version_id, page_number], map: "ix_annotation_owner_page")
  @@index([version_id], map: "ix_annotation_version")
  @@unique([user_id, request_id], map: "ux_annotation_owner_request")
  @@schema("hucescholar")
}

